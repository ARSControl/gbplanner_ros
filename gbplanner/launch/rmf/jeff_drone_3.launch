  <include file="$(find gbplanner_ros)/launch/rmf/rmf_robot.launch">
    <arg name="robot_name" value="rmf_obelix_3"/>
    <arg name="base_name" value ="rmf_obelix"/>
    <arg name="robot_x" default="73.5.0"/>
    <arg name="robot_y" default="30.0"/>
    <arg name="robot_z" default="0.5"/>
    <arg name="launch_prefix" default=""/>
    <arg name="use_sim_time" default="true"/>
    <arg name="num_robots" value="3"/>
  </include>