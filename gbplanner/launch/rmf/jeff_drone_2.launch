<launch>
  <param name="/use_sim_time" value="true"/>
  <param name="/num_robots" value="3"/>

  <include file="$(find gbplanner)/launch/rmf/rmf_robot.launch">
    <arg name="robot_name" value="rmf_obelix_2"/>
    <arg name="base_name" value="rmf_obelix"/>
    <arg name="robot_x" value="150.0"/>
    <arg name="robot_y" value="-230.0"/>
    <arg name="robot_z" value="21.0"/>
    <arg name="launch_prefix" value=""/>
  </include>
</launch>
